NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# SQLite is the default and is enough for local development.
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/dd.sqlite

# Optional legacy SQL Server adapter. Uncomment DATABASE_DRIVER to use it.
# DATABASE_DRIVER=mssql
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=YOUR_DATABASE
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Local development fallback only. Use a random secret in production.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
